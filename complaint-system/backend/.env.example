# Copy this file to .env and fill in real values

# Local SQLite connection string for quick development.
# To use Postgres/MySQL, replace this with the appropriate SQLAlchemy URL.
DATABASE_URL=sqlite:///./dev.db

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# CORS - comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI / LangGraph ---
# Works with any OpenAI-compatible chat completions endpoint.
# Groq (recommended, free to start, serves both models below):
#   LLM_API_BASE_URL=https://api.groq.com/openai/v1
#   Get a key at https://console.groq.com
# Together AI:
#   LLM_API_BASE_URL=https://api.together.xyz/v1
# Local Ollama:
#   LLM_API_BASE_URL=http://localhost:11434/v1  (LLM_API_KEY can be left blank/dummy)
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
# gemma2-9b-it is the assignment's required model; llama-3.3-70b-versatile is
# used as an automatic fallback if the primary model call fails.
LLM_PRIMARY_MODEL=gemma2-9b-it
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES_PER_MODEL=2
